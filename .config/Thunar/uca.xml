<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>edit-copy</icon>
	<name>Copy Path</name>
	<submenu></submenu>
	<unique-id>1755881000000006</unique-id>
	<command>/home/spas/.local/bin/copy-paths %F</command>
	<description>Copy the full path of the selection to the clipboard (one per line)</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>extract-archive</icon>
	<name>Extract Here</name>
	<submenu></submenu>
	<unique-id>1755881000000001</unique-id>
	<command>/home/spas/.local/bin/extract-archives here %F</command>
	<description>Extract the selected archive(s) into the folder they are in</description>
	<range></range>
	<patterns>*.zip;*.ZIP;*.tar;*.TAR;*.tar.gz;*.tgz;*.TGZ;*.TAR.GZ;*.tar.xz;*.txz;*.TXZ;*.TAR.XZ;*.tar.bz2;*.tbz2;*.TBZ2;*.TAR.BZ2;*.tar.zst;*.tzst;*.TZST;*.TAR.ZST;*.tar.lzma;*.tlz;*.TLZ;*.TAR.LZMA;*.7z;*.rar;*.RAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.lzma;*.LZMA;*.zst;*.ZST;*.zstd;*.ZSTD</patterns>
	<other-files/>
</action>
<action>
	<icon>folder-new</icon>
	<name>Extract to New Folder</name>
	<submenu></submenu>
	<unique-id>1755881000000002</unique-id>
	<command>/home/spas/.local/bin/extract-archives folder %F</command>
